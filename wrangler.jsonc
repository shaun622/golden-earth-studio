{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "golden-earth-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "goldenearthstudio.co.uk", "custom_domain": true },
    { "pattern": "www.goldenearthstudio.co.uk", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_ENABLED": "false",
    "CONTACT_FROM": "",
    "CONTACT_TO": "",
    "ALLOWED_ORIGINS": "https://goldenearthstudio.co.uk"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
