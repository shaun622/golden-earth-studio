---
import { getEntry, render } from "astro:content";
import InteriorLayout from "../layouts/InteriorLayout.astro";
const page = await getEntry("pages", "journal2");
if (!page) throw new Error("Journal archive content missing");
const { Content } = await render(page);
const anchors = ["2008", "0104", "0805", "1704", "3101", "2901"];
---
<InteriorLayout title="Journal Archive" description={page.data.description}>
  <main id="content" class="interior-main archive-page">
    <header class="page-intro"><p class="page-kicker">Archive</p><h1>Journal Archive</h1><p>This historical archive preserves older Golden Earth Studio stories and their original date anchors.</p></header>
    <nav class="archive-nav" aria-label="Archive dates">{anchors.map((anchor) => <a href={`#${anchor}`}>{anchor}</a>)}</nav>
    <article class="prose legal-prose"><Content /></article>
    <p><a class="text-link" href="/journal/the-circular-economy-podcast/">Read The Circular Economy Podcast story</a></p>
    <div class="archive-anchors" aria-hidden="true">{anchors.map((anchor) => <span id={anchor}></span>)}</div>
  </main>
</InteriorLayout>
