---
import { getCollection } from "astro:content";
import JournalCard from "../../components/JournalCard.astro";
import InteriorLayout from "../../layouts/InteriorLayout.astro";
import "../../styles/journal.css";

const entries = (await getCollection("journal")).filter((entry) => entry.data.showInIndex).sort((a, b) => a.data.displayOrder - b.data.displayOrder);
---
<InteriorLayout className="journal-interior" title="Journal" description="Curated chronicles of the innovation, news and events as it unfolds." image={entries[0]?.data.cardImage || undefined}>
  <main id="content" class="interior-main journal-page">
    <header class="journal-intro"><h1>Curated chronicles of the <em>innovation</em>,<br />news and events as it unfolds.</h1></header>
    <div class="journal-grid">
      {entries.map((entry) => <JournalCard slug={entry.data.slug} title={entry.data.title} date={entry.data.indexDateLabel} image={entry.data.cardImage} />)}
    </div>
  </main>
</InteriorLayout>
<script>
  // Start the intro under the first navigation link ("Gallery"), moving it left only when its two lines would run off the page.
  const intro = document.querySelector<HTMLElement>(".journal-intro h1");
  const nav = document.querySelector<HTMLElement>(".desktop-nav");
  const align = () => {
    if (!intro || !nav || !nav.offsetWidth) { intro?.style.removeProperty("margin-left"); return; }
    const parent = intro.parentElement!.getBoundingClientRect();
    const padding = parseFloat(getComputedStyle(intro.parentElement!).paddingLeft);
    const room = parent.width - padding * 2 - intro.scrollWidth;
    intro.style.marginLeft = `${Math.max(0, Math.min(nav.getBoundingClientRect().left - parent.left - padding, room))}px`;
  };
  align();
  window.addEventListener("resize", align);
  document.fonts?.ready.then(align);
</script>
