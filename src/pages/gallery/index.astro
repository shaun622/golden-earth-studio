---
import CatalogueCard from "../../components/CatalogueCard.astro";
import ContactForm from "../../components/ContactForm.astro";
import GalleryTabs from "../../components/GalleryTabs.astro";
import InteriorLayout from "../../layouts/InteriorLayout.astro";
import content from "../../data/interior.generated.json";
import "../../styles/reference-pages.css";
---
<InteriorLayout className="reference-interior" title="Gallery" description="Explore the artists who transform construction by-products into fine art and functional ware.">
  <main id="content" class="interior-main gallery-reference">
    <header class="reference-intro"><h1 data-reveal>Explore the artists who <em>transform</em> construction <br />by-products into fine art and functional ware</h1></header>
    <GalleryTabs>
      <div slot="artists" class="reference-catalogue">{content.gallery.artists.map((card) => <CatalogueCard {...card} />)}</div>
      <div slot="artwork" class="reference-catalogue">{content.gallery.artworks.map((card) => <CatalogueCard {...card} />)}</div>
    </GalleryTabs>
    <section id="contact" class="gallery-commission" aria-labelledby="commission-heading">
      <span id="bespoke" class="commission-anchor" aria-hidden="true"></span>
      <div><h2 id="commission-heading" data-reveal>Bespoke Commissions</h2><p data-reveal>{content.gallery.commission[0]}</p><a href="mailto:info@goldenearthstudio.co.uk">info@goldenearthstudio.co.uk</a></div>
      <ContactForm variant="commission" placeholderLabels />
    </section>
  </main>
</InteriorLayout>
