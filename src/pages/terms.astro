---
import { getEntry, render } from "astro:content";
import InteriorLayout from "../layouts/InteriorLayout.astro";
const page = await getEntry("pages", "terms");
if (!page) throw new Error("Terms content missing");
const { Content } = await render(page);
---
<InteriorLayout title="Terms" description={page.data.description}><main id="content" class="interior-main legal-page"><header class="page-intro"><h1>Terms</h1></header><article class="prose legal-prose"><Content /></article></main></InteriorLayout>
