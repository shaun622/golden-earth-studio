---
import ArtworkCard from "../components/ArtworkCard.astro";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import galleryOrder from "../data/gallery.generated.json";
import { resolveMedia } from "../data/media";
import { getCollection } from "astro:content";
import { mediaSource } from "../data/media";
import BaseLayout from "../layouts/BaseLayout.astro";
// Hand-picked works for the homepage strip; the browser shuffles their order on each visit.
const featuredIds = [
  "eleanor-herbosch/unearthing-series-1", "adam-weismann/terre-verte", "louis-vincent/bowl-iii", "jacob-chan/lotus-set",
  "alexandra-yan-wong/ges-2", "arran-gregory/inbetween-worlds", "zahed-tajeddin/beauty-and-the-beast", "edie-evans/bedrock",
  "james-galbraith-kirkpatrick/large-bowl", "lucia-ocejo/jug", "louis-vincent/wall-panel-v", "eleanor-herbosch/unearthing-series-3",
  "arran-gregory/wheel-of-matter", "jacob-chan/ginger-jar-2026", "edie-evans/holding", "zahed-tajeddin/bulls-matter",
  "alexandra-yan-wong/ges-4", "jihyun-kim/teoju",
];
// Every listed artist, alphabetically by first name, for the name list with its portrait preview.
const artistEntries = new Map((await getCollection("artists")).map((entry) => [entry.data.slug, entry.data]));
const homeArtists = galleryOrder.artistOrder.flatMap((slug) => {
  const artist = artistEntries.get(slug);
  const portrait = artist && resolveMedia(artist.portrait).src;
  return artist && portrait ? [{ name: artist.name, discipline: artist.discipline, portrait, href: `/gallery/${slug}/` }] : [];
}).sort((a, b) => a.name.localeCompare(b.name));
const byId = new Map((await getCollection("artworks")).map((entry) => [entry.data.id, entry.data]));
const featuredWorks = featuredIds.flatMap((id) => {
  const work = byId.get(id);
  const image = work && mediaSource(work.cardImage || work.mainImage);
  return work && image ? [{ title: work.title, artist: work.artistName, image, href: `/gallery/${id}/` }] : [];
});

// Homepage Exhibitions slideshow; each slide opens the exhibition's Journal story.
const exhibitions = [
  { title: "Art of the Earth – Six Senses London x Golden Earth Studio", href: "/journal/six-senses-london/", image: "/assets/exhibitions/six-senses-london.webp", width: 1200, height: 983, alt: "Adam Weismann's Terre Verte panels either side of a pool beneath a suspended petal installation at Six Senses London" },
  { title: "Reframing Waste – Bloobloom x Golden Earth Studio", href: "/journal/reframing-waste/", image: "/assets/exhibitions/london-design-festival-2025.webp", width: 1400, height: 1148, alt: "Clay sculptures on a tiled display counter among terracotta shelving at Bloobloom Covent Garden" },
  { title: "Groundworks – London Craft Week", href: "/journal/london-craft-week/", image: "/assets/exhibitions/london-craft-week-2025.webp", width: 1400, height: 1147, alt: "Jacob Chan's chess set, ceramics and material samples on long tables beneath hanging photographs of excavation sites" },
];
---

<BaseLayout
  title="Golden Earth Studio – Art for the Anthropocene"
  description="Golden Earth Studio is a platform for creatives and landscape developers to embrace circularity."
>
  <main id="content" class="page-frame">
    <section class="hero" aria-label="Subsurface by Hal Strode">
      <video autoplay muted loop playsinline preload="metadata">
        <source src="/assets/video/homepage.mp4" type="video/mp4" />
      </video>
      <div class="hero-shade"></div>
      <Header />
      <p class="hero-credit">Subsurface by Hal Strode</p>
    </section>

    <section class="intro section-pad">
      <div class="intro-inner">
        <h1 data-reveal>Art for the Anthropocene</h1>
        <span class="small-rule" aria-hidden="true"></span>
        <p data-reveal style="--reveal-delay: 140ms">
          Bridging the gap between creatives and<br />
          construction in pursuit of <em>circularity.</em>
        </p>
      </div>
    </section>

    <section class="gallery-section section-pad" aria-labelledby="gallery-heading">
      <div class="section-heading-row">
        <h2 id="gallery-heading" data-reveal><a href="/gallery/">Gallery</a></h2>
        <span aria-hidden="true"></span>
      </div>
      <div class="artwork-strip" data-artwork-strip>
        <div class="artwork-strip-track" data-artwork-track>
          {featuredWorks.map((artwork) => <ArtworkCard {...artwork} />)}
        </div>
      </div>
    </section>

    <section class="artists-section section-pad" aria-labelledby="artists-heading">
      <div class="artists-intro">
        <h2 id="artists-heading" data-reveal>Explore the artists transforming construction clay</h2>
        <p data-reveal style="--reveal-delay: 140ms">
          We work with established artists whose practice is deeply rooted in material exploration, skillfully translating their knowledge and research into fine art and functional ware.
        </p>
        <a class="artists-all" href="/gallery/#artists">View all artists</a>
      </div>
      <div class="artists-portrait" aria-hidden="true" data-artists-portraits>
        <img class="artists-portrait-default is-active" src="/assets/images/artists-display.webp" alt="" width="800" height="1000" loading="lazy" />
        {homeArtists.map((artist, index) => (
          <img src={artist.portrait} alt="" width="600" height="750" loading="lazy" data-artist-index={index} />
        ))}
      </div>
      <ul class="artists-names" data-artists-names>
        {homeArtists.map((artist, index) => (
          <li><a href={artist.href} data-artist-index={index}>{artist.name}</a></li>
        ))}
      </ul>
    </section>


    <section class="collective-section exhibitions-section section-pad" aria-labelledby="exhibitions-heading">
      <div class="exhibitions-carousel" data-exhibitions>
        <div class="exhibitions-frame">
          {exhibitions.map((exhibition, index) => (
            <a class="exhibitions-slide" href={exhibition.href} data-exhibition-slide data-title={exhibition.title} aria-hidden={index ? "true" : undefined} tabindex={index ? -1 : undefined}>
              <img src={exhibition.image} alt={exhibition.alt} width={exhibition.width} height={exhibition.height} loading="lazy" />
            </a>
          ))}
          <button class="exhibitions-arrow exhibitions-prev" type="button" aria-label="Previous exhibition" data-exhibitions-prev>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4l-8 8 8 8" /></svg>
          </button>
          <button class="exhibitions-arrow exhibitions-next" type="button" aria-label="Next exhibition" data-exhibitions-next>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg>
          </button>
        </div>
        <a class="exhibitions-caption" href={exhibitions[0].href} aria-live="polite" data-exhibitions-caption>{exhibitions[0].title}</a>
      </div>
      <div class="collective-copy">
        <h2 id="exhibitions-heading" data-reveal>Exhibitions</h2>
        <p data-reveal style="--reveal-delay: 100ms">
          Explore our series of exhibitions where we collaborate with hotels and brands that align with our vision of a circular future. The discarded London clay, transformed by artists and designers, is brought back into interiors through Golden Earth Studio's unique partnerships.
        </p>
      </div>
    </section>

    <section class="journal-section" aria-labelledby="journal-heading">
      <div class="journal-bg" aria-hidden="true"></div>
      <div class="journal-overlay"></div>
      <div class="journal-copy">
        <h2 id="journal-heading" data-reveal><a class="heading-link" href="/journal/">The Journal</a></h2>
        <p data-reveal style="--reveal-delay: 100ms">
          Golden Earth Studio is an ever-evolving initiative, seizing new opportunities to collaborate, innovate and make an impact wherever and however we can.
        </p>
        <p data-reveal style="--reveal-delay: 180ms">
          Our <a href="/journal/">Journal</a> is a documentation of past &amp; future events, where we extend invitations to engage actively, broadcast the availability of waste materials and unveil new art works.
        </p>
      </div>
    </section>

    <ContactSection />

    <Footer />
  </main>
</BaseLayout>
<script>import "../scripts/artwork-strip";</script>
<script>import "../scripts/exhibitions";</script>
<script>import "../scripts/artists-browse";</script>
