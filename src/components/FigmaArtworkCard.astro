---
import type { CollectionEntry } from "astro:content";
import MediaSlot from "./MediaSlot.astro";
interface Props { artwork: CollectionEntry<"artworks">["data"]; }
const { artwork } = Astro.props;
const title = `${artwork.title}${artwork.year ? `, ${artwork.year}` : ""}`;
---
<article class="figma-work-card">
  <a href={`/gallery/${artwork.id}/`} class="figma-work-link" aria-label={`${title} by ${artwork.artistName}`}>
    <MediaSlot media={artwork.mainImage} alt={`${artwork.title} by ${artwork.artistName}`} />
    <span class="figma-work-caption">
      <span class="figma-work-title">{title}</span>
      <span class="figma-work-dimensions">{artwork.dimensions}</span>
      <span class="figma-work-medium">{artwork.tileMedium || artwork.materials}</span>
    </span>
  </a>
</article>
