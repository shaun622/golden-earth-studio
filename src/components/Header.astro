---
import { isCurrentPath, navigation } from "../data/site";

interface Props { variant?: "overlay" | "interior"; }
const { variant = "overlay" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class:list={["site-header", `site-header--${variant}`]}>
  <a class="brand" href="/" aria-label="Golden Earth Studio home">Golden Earth <em>Studio</em></a>
  <div class="header-actions">
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item) => <a href={item.href} aria-current={isCurrentPath(currentPath, item.href) ? "page" : undefined}>{item.label}</a>)}
    </nav>
    <button class="search-button" type="button" aria-expanded="false" aria-controls="site-search" aria-label="Search artists and artworks" data-search-button>
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="1.2" /><path d="M13 13l5 5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" /></svg>
    </button>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Open menu" data-menu-button>
      <span></span><span></span>
    </button>
  </div>
  <div id="site-search" class="site-search" data-search-panel hidden>
    <form class="site-search-form" role="search" action="/gallery/" data-search-form>
      <label class="visually-hidden" for="site-search-input">Search artists and artworks</label>
      <input id="site-search-input" type="search" name="q" placeholder="Search artists and artworks" autocomplete="off" spellcheck="false" data-search-input />
      <button class="site-search-close" type="button" aria-label="Close search" data-search-close>×</button>
    </form>
    <p class="site-search-status" role="status" aria-live="polite" data-search-status></p>
    <ul class="site-search-results" data-search-results></ul>
  </div>
  <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation" data-mobile-menu hidden>
    {navigation.map((item) => <a href={item.href} aria-current={isCurrentPath(currentPath, item.href) ? "page" : undefined}>{item.label}</a>)}
  </nav>
</header>

<script>import "../scripts/search";</script>
