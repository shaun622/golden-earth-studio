---
import ContactForm from "./ContactForm.astro";
import { navigation, site } from "../data/site";
---

<footer class="site-footer">
  <div class="footer-identity">
    <p class="footer-brand">Golden Earth <em>Studio</em></p>
    <p><em>Established 2022</em> ©</p>
    <p class="legal-links">
      <a href="/terms/">Terms</a>
      <span aria-hidden="true">|</span>
      <a href="/privacy-policy/">Privacy Policy</a>
    </p>
  </div>
  <nav class="footer-nav" aria-label="Footer navigation">
    {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="footer-contact">
    <ContactForm compact />
    <a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a>
    <div class="social-links">
      <a href={site.linkedin} aria-label="Golden Earth Studio on LinkedIn">in</a>
      <a href={site.instagram} aria-label="Golden Earth Studio on Instagram">ig</a>
    </div>
  </div>
</footer>
