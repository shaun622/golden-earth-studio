---
import ContactForm from "./ContactForm.astro";
import { navigation, site } from "../data/site";
---

<footer class="site-footer">
  <div class="footer-identity">
    <p class="footer-brand">Golden Earth <em>Studio</em></p>
    <p><em>Established 2022</em> ©</p>
    <p class="legal-links">
      <a href="/terms/">Terms</a>
      <span aria-hidden="true">|</span>
      <a href="/privacy-policy/">Privacy Policy</a>
    </p>
  </div>
  <nav class="footer-nav" aria-label="Footer navigation">
    {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="footer-contact">
    <ContactForm compact />
    <a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a>
    <div class="social-links">
      <a href={site.linkedin} aria-label="Golden Earth Studio on LinkedIn" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
      </a>
      <a href={site.instagram} aria-label="Golden Earth Studio on Instagram (@goldenearthstudio)" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><rect x="2" y="2" width="20" height="20" rx="5.5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.6" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.6" cy="6.4" r="1.15" fill="currentColor"/></svg>
      </a>
    </div>
  </div>
</footer>
