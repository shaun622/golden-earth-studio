---
import MediaSlot from "./MediaSlot.astro";
import type { MediaReference } from "../data/media";
interface Props { href: string; label: string; image: MediaReference; hoverImage: MediaReference; objectPosition: string; }
const { href, label, image, hoverImage, objectPosition } = Astro.props;
---
<article class="reference-catalogue-card">
  <a href={href} class="reference-catalogue-image" aria-label={label}>
    <MediaSlot media={image} alt={label} objectPosition={objectPosition} />
    <MediaSlot media={hoverImage} className="reference-catalogue-hover" decorative />
  </a>
  <h2><a href={href}>{label}</a></h2>
</article>
