---
interface Props {
  title: string;
  artist: string;
  image: string;
  href: string;
}

const { title, artist, image, href } = Astro.props;
---

<article class="artwork-card">
  <a href={href} class="artwork-image-link" aria-label={`${title} by ${artist}`}>
    <img src={image} alt={`${title} by ${artist}`} width="800" height="600" loading="lazy" />
  </a>
  <h3><a href={href}>{title} <span>by {artist}</span></a></h3>
</article>
