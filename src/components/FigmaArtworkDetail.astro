---
import type { CollectionEntry } from "astro:content";
import InteriorLayout from "../layouts/InteriorLayout.astro";
import MediaSlot from "./MediaSlot.astro";
import ContactForm from "./ContactForm.astro";
import FigmaCommission from "./FigmaCommission.astro";
import { mediaSource, resolveMedia } from "../data/media";
import { getCollection } from "astro:content";
import { relatedPool } from "../data/related";
import "../styles/gallery-2026.css";
import sharp from "sharp";
interface Props { artwork: CollectionEntry<"artworks">["data"]; }
const { artwork } = Astro.props;
const related = relatedPool(artwork, (await getCollection("artworks")).map((entry) => entry.data)).map((work) => ({
  href: `/gallery/${work.id}/`,
  title: work.year ? `${work.title}, ${work.year}` : work.title,
  artist: work.artistName,
  artistSlug: work.artistSlug,
  image: resolveMedia(work.cardImage || work.mainImage),
}));
const displayTitle = `${artwork.title}${artwork.year ? `, ${artwork.year}` : ""}`;
// Plain image paths (migrated works) carry no size, so read the real pixel dimensions from the file.
async function measured(image: ReturnType<typeof resolveMedia>, reference: unknown) {
  if (typeof reference !== "string" || !image.src) return image;
  const { width = image.width, height = image.height } = await sharp(`public${image.src}`).metadata();
  return { ...image, width, height };
}
const asset = await measured(resolveMedia(artwork.mainImage, `${artwork.title} by ${artwork.artistName}`), artwork.mainImage);
// Extra photos stack below the main image in display order; a gallery entry repeating the main photo is skipped.
const extraImages = (await Promise.all(artwork.gallery.map(async (item) => {
  const image = await measured(resolveMedia(item.src, item.alt), item.src);
  return image.src && image.src !== asset.src ? [{ src: image.src, alt: item.alt, width: image.width, height: image.height, slot: image.slot }] : [];
}))).flat();
const hasDescription = Astro.slots.has("default");
// All stacked photos share one width, sized so the tallest still fits within the window.
const stackAspect = Math.min(...[asset, ...extraImages].filter((image) => image.src).map((image) => image.width / image.height));
// Approximate heading width in ems so the title and artist can shrink to stay on one line.
const headingEms = (0.42 * displayTitle.length + 0.45 * artwork.artistName.length).toFixed(2);
const landscape = artwork.artistSlug === "edie-evans";
---
<InteriorLayout className="figma-interior" title={`${displayTitle} | ${artwork.artistName}`} description={artwork.seoDescription} image={mediaSource(artwork.mainImage)}>
  <main id="content" class:list={["figma-product", { "figma-product--described": hasDescription, "figma-product--landscape": landscape, "figma-product--screen": artwork.slug === "tiled-screen" }]}>
    <section class="figma-product-detail" aria-labelledby="artwork-heading">
      <div class="figma-product-columns">
        <div class="figma-product-copy">
          <h1 id="artwork-heading" class="figma-product-heading" style={`--heading-ems: ${headingEms}`}><span>{displayTitle}</span><span class="figma-product-heading-separator" aria-hidden="true">|</span><a href={`/gallery/${artwork.artistSlug}/`}>{artwork.artistName}</a></h1>
          <dl class="figma-product-facts">
            {artwork.collaborator && <div><dt class="visually-hidden">Collaboration</dt><dd>In collaboration with {artwork.collaborator}</dd></div>}
            {artwork.dimensions && <div><dt class="visually-hidden">Dimensions</dt><dd>{artwork.dimensions}</dd></div>}
            {artwork.materials && <div><dt class="visually-hidden">Materials</dt><dd>{artwork.materials}</dd></div>}
            {artwork.sold ? <div><dt class="visually-hidden">Availability</dt><dd>Sold</dd></div> : artwork.price && <div><dt class="visually-hidden">Price</dt><dd>{artwork.price}</dd></div>}
          </dl>
          {hasDescription && <div class="figma-product-description"><slot /></div>}
          <section class="figma-enquiry" aria-labelledby="enquire-heading">
            <h2 id="enquire-heading">Enquire now</h2>
            <ContactForm variant="artwork" artworkId={artwork.id} artworkTitle={artwork.title} presentation="figma-2026" />
          </section>
        </div>
        <div class="figma-product-media" data-media-slot={asset.src ? asset.slot : undefined} style={Number.isFinite(stackAspect) ? `--stack-aspect: ${stackAspect.toFixed(4)}` : undefined}>
          {asset.src ? (
            <div class="figma-product-photos">
              {[{ ...asset, src: asset.src }, ...extraImages].map((image, index) => <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading={index === 0 ? "eager" : "lazy"} data-media-slot={index === 0 ? undefined : image.slot} style={`--image-ratio: ${image.width} / ${image.height}`} />)}
            </div>
          ) : <MediaSlot media={artwork.mainImage} loading="eager" />}
        </div>
      </div>
    </section>
    <section class="figma-related" aria-labelledby="related-heading">
      <h2 id="related-heading">Related Artworks</h2>
      <div class="figma-related-grid" data-related-pool>
        {related.map((item, index) => <article class="figma-related-card" hidden={index >= 4} data-artist={item.artistSlug}><a href={item.href}><img src={item.image.src!} alt={item.image.alt || `${item.title} by ${item.artist}`} width={item.image.width} height={item.image.height} loading="lazy" /><h3>{item.title} <span>by {item.artist}</span></h3></a></article>)}
      </div>
    </section>
    <FigmaCommission />
  </main>
</InteriorLayout>
<script>
  // Show a fresh random four of the similar works on every visit, one per artist where possible;
  // without JavaScript the first four remain.
  document.querySelectorAll<HTMLElement>("[data-related-pool]").forEach((grid) => {
    const cards = [...grid.querySelectorAll<HTMLElement>(".figma-related-card")];
    for (let i = cards.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [cards[i], cards[j]] = [cards[j], cards[i]];
    }
    const artists = new Set<string>();
    const picked = cards.filter((card) => !artists.has(card.dataset.artist!) && artists.add(card.dataset.artist!)).slice(0, 4);
    for (const card of cards) if (picked.length < 4 && !picked.includes(card)) picked.push(card);
    cards.forEach((card) => { card.hidden = !picked.includes(card); });
    picked.forEach((card) => grid.appendChild(card));
  });
</script>
