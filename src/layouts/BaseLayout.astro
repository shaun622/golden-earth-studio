---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = "/assets/images/hero-fallback.webp", noindex = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || "https://goldenearthstudio.co.uk");
const socialImage = new URL(image, Astro.site || "https://goldenearthstudio.co.uk");
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <link rel="preload" href="/assets/fonts/baskervville-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/gill-sans-mt-light.ttf" as="font" type="font/ttf" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    <script>
      import "../scripts/navigation";
      import "../scripts/motion";
      import "../scripts/contact";
    </script>
  </body>
</html>
